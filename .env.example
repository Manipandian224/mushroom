# MushroomSense AI - Environment Configuration Template
# Copy this file to .env.local and fill in the actual values.

# --- Firebase Public Configuration (Client-side) ---
# These are used in src/firebase/config.ts to initialize the Firebase SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# --- GenAI / Google AI Configuration (Server-side) ---
# Used by Genkit for mushroom image analysis.
# DO NOT prefix these with NEXT_PUBLIC_ to keep them secure.
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# --- App Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
